# IMS — Environment Variables
# Copy to `.env.local` and fill in real values. Never commit `.env*` files.
# Per-environment values live in Vercel Project Settings (Development / Preview / Production).

# Supabase project URL (client + server safe). Example: https://bgidjknqkxxqojkxozhu.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key. Safe to ship to the browser (protected by RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. SERVER-ONLY SECRET — never expose to the client bundle.
# Used by server actions/route handlers for privileged operations. One per project/env.
SUPABASE_SERVICE_ROLE_KEY=

# Auto-injected by Vercel during builds/CI to mint short-lived deploy tokens.
# Not needed locally. Leave unset in development.
# VERCEL_OIDC_TOKEN=

# Optional: database password used by `supabase db` CLI against the linked project.
# SUPABASE_DB_PASSWORD=

# Optional: studio/edge functions secrets (configured in supabase/config.toml).
# OPENAI_API_KEY=